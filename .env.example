# RIO holds Big Ears proxy credentials plus recordings-upload credentials.
# LLM keys, STT keys for processing live in Big Ears — not here.

BIG_EARS_API_URL=http://localhost:8080
BIG_EARS_API_KEY=change-me

# ── Recordings upload (presigned PUT from the ingest page) ─────────────
# Set RECORDINGS_STORAGE to pick the backend; auto-detects if unset
# (Supabase when SUPABASE_* is set, else S3 when AWS_* + S3_BUCKET is set).
RECORDINGS_STORAGE=supabase

# Supabase (default for hackathon dev)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bigears-recordings

# S3 (switch RECORDINGS_STORAGE=s3 and fill these instead)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=bigears-recordings
STORAGE_UPLOAD_TTL_SEC=900
